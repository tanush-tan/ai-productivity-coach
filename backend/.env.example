# Server Port
PORT=5000

# PostgreSQL Connection String
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/ai_productivity_coach

# JWT Authentication
# In production, use a strong, cryptographically random secret (e.g., openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h
